# Telegram Bot Token (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Google Gemini API Key (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Пароль для входа в панель управления (Dashboard)
ADMIN_PASSWORD="artem_secret_password"

# Секретный токен для вебхука Telegram (любая случайная строка для безопасности)
TELEGRAM_SECRET_TOKEN="super_secret_webhook_token_123"

# Секрет для Vercel Cron (опционально, передается автоматически Vercel в CRON_SECRET)
CRON_SECRET=""

# URL вашего развернутого приложения на Vercel (например: https://artem-bot.vercel.app)
# Нужен для автоматической настройки Webhook одной кнопкой
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Опционально: Upstash Redis для персистентного хранения настроек между холодными стартами Vercel
# (Если не указан, настройки берутся из памяти / переменных окружения)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
